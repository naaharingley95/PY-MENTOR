# PyMentor AI Backend Configuration

# JWT Secret — generate a strong random key
JWT_SECRET_KEY=change-me-to-a-random-secret-string

# Google Gemini API Key — get one free at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Database URL (SQLite default)
DATABASE_URL=sqlite+aiosqlite:///./pymentor.db

# CORS origin (frontend URL)
FRONTEND_URL=http://localhost:5173
